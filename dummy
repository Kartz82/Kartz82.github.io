<script>
const io = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if(e.isIntersecting){
      const siblings = Array.from(document.querySelectorAll('.proj-list .reveal'));
      const idx = siblings.indexOf(e.target);
      const delay = idx >= 0 ? idx * 55 : 0;
      setTimeout(() => e.target.classList.add('in'), delay);
      io.unobserve(e.target);
    }
  });
}, {threshold: 0.07});
document.querySelectorAll('.reveal').forEach(el => io.observe(el));

function toggle(btn){
  const detail = btn.nextElementSibling;
  const arr = btn.querySelector('.arr');
  const open = detail.classList.toggle('open');
  arr.style.transform = open ? 'rotate(90deg)' : '';
}

window.addEventListener('scroll', () => {
  const y = window.scrollY;
  document.querySelectorAll('.nav-links a').forEach(a => {
    const sec = document.querySelector(a.getAttribute('href'));
    if(sec && y >= sec.offsetTop-80 && y < sec.offsetTop+sec.offsetHeight-80)
      a.style.color='var(--org)';
    else a.style.color='';
  });
},{passive:true});
</script>
