<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kartikeya Vemula — Data Analyst</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --canvas:   #F0F5F4;
  --surface:  #E4EDEB;
  --card:     #FFFFFF;
  --rule:     #C2D4D1;
  --ink:      #0D1F1C;
  --ink2:     #3D5E59;
  --ink3:     #7A9E99;
  --org:      #D4621A;
  --org-h:    #B5501A;
  --org-lt:   #E07A3A;
  --org-bg:   rgba(212,98,26,0.07);
  --org-rule: rgba(212,98,26,0.2);
  --green:    #22c55e;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--canvas);color:var(--ink);font-family:'Inter',sans-serif;font-size:15px;line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
::selection{background:var(--org);color:#fff;}
::-webkit-scrollbar{width:5px;}
::-webkit-scrollbar-track{background:var(--canvas);}
::-webkit-scrollbar-thumb{background:var(--org-lt);border-radius:3px;}

/* ── NAV ── */
nav{position:sticky;top:0;z-index:100;height:54px;background:rgba(240,245,244,0.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--rule);display:flex;align-items:center;}
.nav-in{max-width:1000px;margin:0 auto;padding:0 36px;width:100%;display:flex;align-items:center;justify-content:space-between;}
.logo{font-family:'DM Mono',monospace;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink);text-decoration:none;display:flex;align-items:center;gap:9px;}
.logo-dot{width:8px;height:8px;border-radius:50%;background:var(--green);animation:pdot 2.4s ease-in-out infinite;}
.logo span{color:var(--org);}
.nav-links{display:flex;gap:28px;list-style:none;}
.nav-links a{font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2);text-decoration:none;position:relative;transition:color .2s;}
.nav-links a::after{content:'';position:absolute;bottom:-3px;left:0;right:0;height:1px;background:var(--org);transform:scaleX(0);transform-origin:left;transition:transform .25s ease;}
.nav-links a:hover{color:var(--org);}
.nav-links a:hover::after{transform:scaleX(1);}
.nav-badge{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.08em;background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.3);color:var(--green);padding:4px 10px;border-radius:20px;display:flex;align-items:center;gap:5px;}
.nav-badge-dot{width:5px;height:5px;border-radius:50%;background:var(--green);animation:pdot 2s ease-in-out infinite;}

.wrap{max-width:1000px;margin:0 auto;padding:0 36px;}

/* ── HERO ── */
#hero{padding:80px 0 64px;border-bottom:1px solid var(--rule);}
.eyebrow{font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--org);margin-bottom:18px;display:flex;align-items:center;gap:12px;opacity:0;animation:fup .6s ease forwards .05s;}
.eyebrow::before{content:'';width:28px;height:1px;background:var(--org);}
h1{font-family:'Inter',sans-serif;font-size:clamp(46px,6.5vw,76px);line-height:.97;color:var(--ink);font-weight:700;letter-spacing:-.02em;opacity:0;animation:fup .7s ease forwards .18s;}
h1 em{font-style:normal;color:var(--org);}
.hero-role{font-family:'DM Mono',monospace;font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2);margin-top:14px;opacity:0;animation:fup .7s ease forwards .3s;}
.hero-bio{max-width:600px;font-size:15.5px;font-weight:300;color:var(--ink2);margin-top:20px;line-height:1.8;opacity:0;animation:fup .7s ease forwards .42s;}
.hero-bio strong{color:var(--ink);font-weight:500;}

/* outcome pill strip */
.outcome-strip{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px;opacity:0;animation:fup .7s ease forwards .5s;}
.outcome-pill{display:inline-flex;align-items:center;gap:7px;background:var(--org-bg);border:1px solid var(--org-rule);border-radius:4px;padding:6px 14px;font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.04em;color:var(--org);}
.outcome-pill b{color:var(--ink);font-family:'Inter',sans-serif;font-size:13px;font-weight:700;}

/* hero CTA row */
.hero-cta{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:32px;opacity:0;animation:fup .7s ease forwards .62s;}
.btn{display:inline-flex;align-items:center;gap:7px;font-family:'DM Mono',monospace;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:11px 22px;border-radius:4px;transition:.2s;font-weight:500;}
.btn-fill{background:var(--org);color:#fff;}
.btn-fill:hover{background:var(--org-h);transform:translateY(-1px);}
.btn-ghost{border:1px solid var(--rule);color:var(--ink2);}
.btn-ghost:hover{border-color:var(--org);color:var(--org);transform:translateY(-1px);}

/* LeetCode consistency card */
.lc-card{display:inline-flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--rule);padding:10px 18px;border-radius:5px;text-decoration:none;transition:.2s;}
.lc-card:hover{border-color:var(--org);transform:translateY(-1px);}
.lc-icon{font-size:20px;line-height:1;}
.lc-text{}
.lc-val{font-family:'Inter',sans-serif;font-size:17px;color:var(--ink);font-weight:700;line-height:1;}
.lc-lbl{font-family:'DM Mono',monospace;font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink3);display:block;margin-top:1px;}
.lc-sub{font-family:'DM Mono',monospace;font-size:9px;letter-spacing:.06em;color:var(--org);display:block;margin-top:2px;}

/* available immediately pill */
.avail-pill{display:inline-flex;align-items:center;gap:7px;background:rgba(34,197,94,0.08);border:1px solid rgba(34,197,94,0.25);border-radius:20px;padding:7px 16px;font-family:'DM Mono',monospace;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--green);}
.avail-dot{width:7px;height:7px;border-radius:50%;background:var(--green);animation:pdot 2s ease-in-out infinite;flex-shrink:0;}

/* ── KPI BAR ── */
#kpi{border-bottom:1px solid var(--rule);}
.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);}
.kpi-cell{padding:28px 0;border-right:1px solid var(--rule);padding-right:28px;}
.kpi-cell:not(:first-child){padding-left:28px;}
.kpi-cell:last-child{border-right:none;}
.kpi-num{font-family:'Inter',sans-serif;font-size:40px;line-height:1;color:var(--ink);font-weight:700;letter-spacing:-.02em;}
.kpi-num span{color:var(--org);}
.kpi-lbl{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink3);margin-top:6px;}
.kpi-delta{font-size:11.5px;color:var(--org);margin-top:4px;font-weight:500;}

/* ── SKILLS ── */
#skills{padding:60px 0;border-bottom:1px solid var(--rule);}
.sec-label{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink3);display:flex;align-items:center;gap:10px;margin-bottom:28px;}
.sec-label::after{content:'';flex:1;max-width:100px;height:1px;background:var(--rule);}
.skills-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--rule);border:1px solid var(--rule);border-radius:8px;overflow:hidden;}
.sk{background:var(--card);padding:24px 22px;transition:background .2s;}
.sk:hover{background:var(--surface);}
.sk h3{font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--org);margin-bottom:10px;display:flex;align-items:center;gap:8px;}
.sk h3::before{content:'';width:3px;height:13px;background:var(--org);border-radius:2px;flex-shrink:0;}
.sk p{font-size:13px;font-weight:300;color:var(--ink2);line-height:1.75;}

/* ── PROJECTS ── */
#projects{padding:60px 0;}
.proj-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:32px;}
.sec-title{font-family:'Inter',sans-serif;font-size:clamp(26px,3.5vw,38px);color:var(--ink);font-weight:700;letter-spacing:-.02em;}
.proj-count{font-family:'DM Mono',monospace;font-size:11px;color:var(--ink3);letter-spacing:.1em;}
.proj-list{display:flex;flex-direction:column;gap:2px;}
.pcard{background:var(--card);border:1px solid var(--rule);border-radius:6px;overflow:hidden;transition:transform .2s,box-shadow .2s,border-color .2s;position:relative;}
.pcard::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--org);transform:scaleY(0);transform-origin:bottom;transition:transform .28s ease;}
.pcard:hover{transform:translateX(4px);box-shadow:-3px 0 20px rgba(212,98,26,.08);border-color:var(--org-rule);}
.pcard:hover::before{transform:scaleY(1);}
.pcard-inner{display:grid;grid-template-columns:64px 1fr auto;}
.pcard-num{padding:22px 16px;font-family:'Inter',sans-serif;font-size:20px;font-weight:600;color:var(--rule);border-right:1px solid var(--rule);display:flex;align-items:flex-start;justify-content:center;transition:color .2s;}
.pcard:hover .pcard-num{color:var(--org-lt);}
.pcard-body{padding:20px 22px;}
.pcard-title{font-size:14.5px;font-weight:500;color:var(--ink);transition:color .2s;line-height:1.4;}
.pcard:hover .pcard-title{color:var(--org-h);}
.pcard-impact{font-size:12px;color:var(--org);font-weight:500;margin-top:6px;font-family:'DM Mono',monospace;letter-spacing:.03em;}
.pcard-tags{display:flex;gap:5px;margin-top:9px;flex-wrap:wrap;}
.tag{font-family:'DM Mono',monospace;font-size:10px;background:var(--surface);border:1px solid var(--rule);color:var(--ink2);padding:2px 8px;border-radius:3px;transition:border-color .2s;}
.pcard:hover .tag{border-color:var(--org-rule);}
.pcard-detail{font-size:13px;font-weight:300;color:var(--ink2);line-height:1.7;max-width:600px;max-height:0;overflow:hidden;transition:max-height .35s ease,margin-top .35s ease;margin-top:0;}
.pcard-detail.open{max-height:240px;margin-top:10px;}
.hl{color:var(--org);font-weight:500;}
.struck{color:var(--ink3);text-decoration:line-through;text-decoration-color:rgba(122,158,153,.5);}
.pcard-toggle{background:none;border:none;cursor:pointer;font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3);padding:0;margin-top:10px;display:flex;align-items:center;gap:5px;transition:color .2s;}
.pcard-toggle:hover{color:var(--org);}
.pcard-toggle .arr{transition:transform .25s;display:inline-block;}
.pcard-kpi{padding:22px 24px;border-left:1px solid var(--rule);min-width:120px;display:flex;flex-direction:column;align-items:flex-end;justify-content:center;}
.kpi-big{font-family:'Inter',sans-serif;font-size:32px;font-weight:700;color:var(--org);line-height:1;letter-spacing:-.02em;}
.kpi-sub{font-family:'DM Mono',monospace;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3);margin-top:4px;text-align:right;}
.kpi-was{font-size:11px;color:var(--ink3);margin-top:3px;text-decoration:line-through;text-decoration-color:rgba(122,158,153,.5);}

/* ── EDUCATION ── */
#education{padding:60px 0;border-top:1px solid var(--rule);}
.edu-row{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding:22px 0;border-bottom:1px solid var(--rule);transition:padding-left .2s;}
.edu-row:last-child{border-bottom:none;}
.edu-row:hover{padding-left:8px;}
.edu-deg{font-family:'Inter',sans-serif;font-size:18px;font-weight:600;color:var(--ink);}
.edu-school{font-size:13px;color:var(--ink2);margin-top:3px;}
.edu-spec{font-family:'DM Mono',monospace;font-size:10px;color:var(--ink3);margin-top:6px;letter-spacing:.05em;}
.edu-meta{text-align:right;flex-shrink:0;}
.edu-gpa{font-family:'Inter',sans-serif;font-size:24px;font-weight:700;color:var(--org);letter-spacing:-.02em;}
.edu-yr{font-family:'DM Mono',monospace;font-size:10px;color:var(--ink3);margin-top:3px;letter-spacing:.08em;}
.edu-badge{display:inline-block;font-family:'DM Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.25);color:var(--green);padding:3px 8px;border-radius:3px;margin-top:6px;}

/* ── AVAILABILITY ── */
#availability{padding:44px 0;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);}
.avail-inner{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:24px;}
.avail-left-block{}
.avail-heading{font-family:'Inter',sans-serif;font-size:18px;font-weight:600;color:var(--ink);display:flex;align-items:center;gap:10px;}
.avail-heading-dot{width:9px;height:9px;border-radius:50%;background:var(--green);animation:pdot 2s ease-in-out infinite;}
.avail-roles{font-family:'DM Mono',monospace;font-size:10px;color:var(--ink3);margin-top:7px;letter-spacing:.06em;line-height:1.8;}
.location-chips{display:flex;flex-wrap:wrap;gap:8px;max-width:440px;}
.loc-chip{font-family:'DM Mono',monospace;font-size:10.5px;letter-spacing:.06em;background:var(--card);border:1px solid var(--rule);color:var(--ink2);padding:7px 14px;border-radius:4px;display:flex;align-items:center;gap:6px;transition:border-color .2s;}
.loc-chip:hover{border-color:var(--org);}
.loc-chip .flag{font-size:13px;}

/* ── FOOTER ── */
footer{background:var(--ink);margin-top:0;}
.ft-inner{max-width:1000px;margin:0 auto;padding:52px 36px 40px;display:flex;align-items:flex-start;justify-content:space-between;gap:40px;flex-wrap:wrap;}
.ft-hed{font-family:'Inter',sans-serif;font-size:clamp(24px,3vw,34px);font-weight:700;color:#fff;line-height:1.15;letter-spacing:-.02em;}
.ft-hed em{font-style:normal;color:var(--org-lt);}
.ft-sub{font-family:'DM Mono',monospace;font-size:10.5px;color:rgba(255,255,255,.35);margin-top:8px;letter-spacing:.08em;}
.ft-links{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
.btn-ft-fill{background:var(--org);color:#fff;border:none;}
.btn-ft-fill:hover{background:var(--org-lt);}
.btn-ft-ghost{border:1px solid rgba(255,255,255,.18);color:rgba(255,255,255,.7);}
.btn-ft-ghost:hover{border-color:var(--org-lt);color:var(--org-lt);}
.ft-bottom{max-width:1000px;margin:0 auto;padding:16px 36px 32px;display:flex;justify-content:space-between;border-top:1px solid rgba(255,255,255,.08);flex-wrap:wrap;gap:6px;}
.ft-copy{font-family:'DM Mono',monospace;font-size:10px;color:rgba(255,255,255,.25);letter-spacing:.06em;}

@keyframes fup{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}
@keyframes pdot{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.3;transform:scale(.6);}}
.reveal{opacity:0;transform:translateY(16px);transition:opacity .55s ease,transform .55s ease;}
.reveal.in{opacity:1;transform:none;}

@media(max-width:768px){
  .nav-links{display:none;}
  .nav-badge{display:none;}
  .kpi-grid{grid-template-columns:repeat(2,1fr);}
  .skills-grid{grid-template-columns:1fr;}
  .pcard-inner{grid-template-columns:48px 1fr;}
  .pcard-kpi{display:none;}
  .edu-row{flex-direction:column;gap:6px;}
  .edu-meta{text-align:left;}
  .ft-inner{flex-direction:column;}
  .avail-inner{flex-direction:column;align-items:flex-start;}
  .outcome-strip{gap:8px;}
}
</style>
</head>
